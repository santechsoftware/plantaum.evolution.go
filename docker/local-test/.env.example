# Copy to .env in this directory, then fill in EVOLUTION_LICENSE_KEY.
#
#   cp docker/local-test/.env.example docker/local-test/.env

# The key sent in the `apikey` header on every request.
GLOBAL_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# Evolution license key, used by activate.sh to license both servers OFFLINE.
# This is the code you received from license.evolutionfoundation.com.br — the
# same one you passed to /license/activate?code=... on your first install.
# Without it, /instance/* answers 503 LICENSE_REQUIRED and no test can run.
EVOLUTION_LICENSE_KEY=

# Shared instance id for both servers. Leave empty and activate.sh generates
# one and writes it back here, so re-runs reuse it and your licence never sees
# a new device. Set it to your production install's instance_id to match it.
EVOLUTION_INSTANCE_ID=

# Host ports
FIXED_PORT=8080
BASELINE_PORT=8081
POSTGRES_PORT=55432

# Global Postgres ceiling — kept roomy on purpose.
PG_MAX_CONNECTIONS=200

# The ceiling that actually matters: each server's role gets its own budget, so
# the leaking baseline exhausts itself without starving the fixed server. Low
# enough that ~60 instances reproduce the production failure.
PG_ROLE_CONN_LIMIT=60

# INFO keeps the logs readable; DEBUG shows every whatsmeow DB statement.
WADEBUG=INFO

# Leave false for the scripted test. Set true + restart to reproduce the
# boot-storm (every stored instance reconnects at once) from the fix commit.
CONNECT_ON_STARTUP=false
