# Copy to .env in this directory, then fill in EVOLUTION_LICENSE_KEY.
#
#   cp docker/local-test/.env.example docker/local-test/.env

# The key sent in the `apikey` header on every request.
GLOBAL_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# Evolution license key, used by activate.sh to license both servers OFFLINE.
# This is the code you received from license.evolutionfoundation.com.br — the
# same one you passed to /license/activate?code=... on your first install.
# Without it, /instance/* answers 503 LICENSE_REQUIRED and no test can run.
EVOLUTION_LICENSE_KEY=

# Shared instance id for both servers. Leave empty and activate.sh generates
# one and writes it back here, so re-runs reuse it and your licence never sees
# a new device. Set it to your production install's instance_id to match it.
EVOLUTION_INSTANCE_ID=

# Host ports — two replicas per side.
FIXED_PORT=8080
FIXED_PORT_2=8082
BASELINE_PORT=8081
BASELINE_PORT_2=8083
POSTGRES_PORT=55432

# Global Postgres ceiling — kept roomy on purpose.
PG_MAX_CONNECTIONS=200

# The ceiling that actually matters: each server's role gets its own budget, so
# the leaking baseline exhausts itself without starving the fixed server. Low
# enough that ~60 instances reproduce the production failure.
PG_ROLE_CONN_LIMIT=60

# INFO keeps the logs readable; DEBUG shows every whatsmeow DB statement.
WADEBUG=INFO

# Leave false for the scripted test. Set true + restart to reproduce the
# boot-storm (every stored instance reconnects at once) from the fix commit.
CONNECT_ON_STARTUP=false

# ── Webhooks ────────────────────────────────────────────────────────────────
# Media arrives inline as base64 when this is true, which is the VENDOR DEFAULT
# (config.go:238 forces "true" when the variable is unset). plantaum matches on
# text only, so keep it false: one video event would otherwise push megabytes
# through the receiver and trip its request-body limit, which Evolution Go reads
# as a failure and retries five times.
WEBHOOK_FILES=false

# Drop status/stories broadcasts — pure noise for shift matching.
EVENT_IGNORE_STATUS=true

# Must stay false. Group messages ARE the product; true drops every @g.us event
# before it reaches the webhook (whatsmeow.go:1211).
EVENT_IGNORE_GROUP=false

# WEBHOOK_URL is deliberately NOT set. It does not work on its own: the whole
# producer call is gated on the PER-INSTANCE webhook being non-empty
# (whatsmeow.go:2348), and only inside Produce does it also fan out to the
# global URL (webhook_producer.go:43-48). Setting both delivers every event
# twice. plantaum.service sends one shared URL as `webhookUrl` on
# POST /instance/connect instead — see README, "Receiving webhooks locally".

# Branding. CLIENT_NAME scopes instance rows (a server only sees instances
# stamped with its own client name); OS_NAME is the device name WhatsApp shows
# under "Linked devices" when a doctor pairs.
CLIENT_NAME=Plantaum
OS_NAME=Plantaum

# Host port for the cache plantaum.service uses. Only change it if 6379 is
# already taken; the API reads its connection string from
# src/Plantaum.Api/Properties/launchSettings.json and the two must agree.
REDIS_PORT=6379
